# Instalar: sudo install -m 644 deploy/muvautomation-detect.timer /etc/systemd/system/
#           sudo systemctl enable --now muvautomation-detect.timer
[Unit]
Description=MuvAutomation - deteccion periodica sobre el access.log

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
