# Instalar: sudo install -m 644 deploy/muvautomation-detect.service /etc/systemd/system/
# Ejecuta scripts/detect.py sobre el access.log de Nginx y el ufw.log (R4, escaneo de puertos).
# El script termina con codigo 10 si hay senales nuevas: se declara exito (SuccessExitStatus=10) para
# que la unidad no quede en "failed" y tape ataques posteriores; las senales van al journal
# (`journalctl -u muvautomation-detect`). Lo ya reportado se recuerda en el StateDirectory.
[Unit]
Description=MuvAutomation - deteccion de enumeracion, fuerza bruta y abuso de privilegios (access.log)

[Service]
Type=oneshot
User=muvapi
Group=muvapi
# /var/log/nginx/access.log es root:adm 0640 en Ubuntu.
SupplementaryGroups=adm
WorkingDirectory=/opt/fdsi-lab3
ExecStart=/opt/fdsi-lab3/.venv/bin/python -I scripts/detect.py /var/log/nginx/access.log --ufw-log /var/log/ufw.log --audit-log /var/log/muvautomation/actions.log --state-file /var/lib/muvautomation-detect/state.json
SuccessExitStatus=10
StateDirectory=muvautomation-detect
StateDirectoryMode=0750

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
