# Copiar a /etc/muvautomation.env en el servidor (NO versionar el archivo real):
#   sudo install -m 600 -o root -g root deploy/muvautomation.env.example /etc/muvautomation.env
# (systemd lee el archivo como root; ni el servicio ni Nginx/www-data necesitan acceso.)
#   sudoedit /etc/muvautomation.env        # reemplazar cada valor; generar claves con: openssl rand -hex 32

# Clave del emisor de alertas (Falcon simulado) para POST /alerts.
# La API rechaza claves de menos de 16 caracteres, de baja variedad o de ejemplo.
MUV_API_KEY=CAMBIAR_POR_VALOR_ALEATORIO

# Analistas SOC: nombre:rol:clave separados por ';'. Roles: lector | respondedor.
# lector: consultar, acknowledge, comment. respondedor: ademas escalate y close.
MUV_ANALYSTS=ana:respondedor:CAMBIAR_CLAVE_ANA;juan:lector:CAMBIAR_CLAVE_JUAN

# Motor de Escalamiento: risk_score a partir del cual se escala automaticamente.
MUV_ESCALATION_THRESHOLD=70

# AbuseIPDB (opcional). Sin clave, el enriquecimiento de IP se omite y la alerta
# se clasifica solo con MITRE ATT&CK. Cuenta gratuita: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=
ABUSEIPDB_DAILY_LIMIT=900
